{
  "name": "automation-engine",
  "version": "2.0.0",
  "description": "AI Agent Repository Automation Engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm --prefix web run build",
    "build:server": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "git",
    "bitbucket",
    "automation",
    "repository-manager",
    "express",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "js-yaml": "^4.1.0",
    "pdfkit": "^0.19.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.17.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
