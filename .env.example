# Optional SSH key identity file to use for Git CLI commands
# SSH_KEY_PATH=/Users/...

# Strict Host Key Checking (accept-new, no, yes)
# SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Workspace Base Directory (defaults to ./workspace)
# WORKSPACE_DIR=./workspace

# AI Model for Code Analysis, PRDs, and Test Engineering (defaults to gemini-2.5-flash)
# AI_MODEL=gemini-2.5-flash
